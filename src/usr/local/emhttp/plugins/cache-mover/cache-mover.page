<script>
    function send(command) {
        if(command == "cleaner_start"){
            document.getElementById("command").value = "/usr/local/emhttp/plugins/cache-mover/scripts/cache_cleaner_cron.sh";
        } else if( command == "mover_start" ){
            document.getElementById("command").value = "/usr/local/emhttp/plugins/cache-mover/scripts/cache_mover_cron.sh";
        }
        document.getElementById("form").submit();
    }

    // ----- "Sign in with Plex" (PIN-based OAuth + server discovery) -----
    var PLEX_AUTH = "/plugins/cache-mover/plex_auth.php";
    var PLEX_CSRF = "<?=$csrf_token;?>";

    function _plexStatusEl(ctx) {
        return document.getElementById(ctx === "extra" ? "plex_status_extra" : "plex_status");
    }
    function _plexServersEl(ctx) {
        return document.getElementById(ctx === "extra" ? "plex_servers_extra" : "plex_servers");
    }
    function _plexStatus(ctx, msg) { _plexStatusEl(ctx).textContent = msg; }
    function _plexField(name) { return document.getElementsByName(name)[0]; }

    // Unraid rejects POSTs (and can reject other requests) without a valid
    // csrf_token, returning a non-JSON page; always attach it.
    function _plexCsrf() { return "csrf_token=" + encodeURIComponent(PLEX_CSRF); }

    // Parse defensively: read text and JSON.parse in a try/catch so a
    // non-JSON reply (auth page, PHP error, 404) surfaces a readable message
    // instead of an opaque "SyntaxError: The string did not match...".
    function _plexJson(r) {
        return r.text().then(function (t) {
            try { return JSON.parse(t); }
            catch (e) { return { error: "unexpected response (" + r.status + "): " + t.slice(0, 180) }; }
        });
    }
    function _plexGet(qs) {
        return fetch(PLEX_AUTH + "?" + qs + "&" + _plexCsrf()).then(_plexJson);
    }
    function _plexPost(body) {
        // csrf in both query and body so it satisfies $_GET/$_POST checks.
        return fetch(PLEX_AUTH + "?" + _plexCsrf(), {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: body + "&" + _plexCsrf()
        }).then(_plexJson);
    }

    function plexSignIn(ctx) {
        _plexServersEl(ctx).innerHTML = "";
        _plexStatus(ctx, "Starting Plex sign-in...");
        var cidEl = document.getElementById("mediaserver_client_id");
        _plexGet("action=pin&client_id=" + encodeURIComponent(cidEl.value || "")).then(function (d) {
            if (d.error) { _plexStatus(ctx, "Error: " + d.error); return; }
            cidEl.value = d.client_id;               // persist on next Apply
            var win = window.open(d.auth_url, "plexauth", "width=820,height=740");
            if (!win) { _plexStatus(ctx, "Popup blocked - allow popups for this page and try again."); return; }
            _plexStatus(ctx, "Waiting for you to sign in (finish in the Plex popup)...");
            plexPoll(d.id, d.client_id, 0, win, ctx);
        }).catch(function (e) { _plexStatus(ctx, "Error: " + e); });
    }

    function plexPoll(id, cid, tries, win, ctx) {
        if (tries > 90) { _plexStatus(ctx, "Timed out waiting for sign-in. Try again."); return; }
        _plexGet("action=poll&id=" + encodeURIComponent(id) + "&client_id=" + encodeURIComponent(cid)).then(function (d) {
            if (d.error) { _plexStatus(ctx, "Error: " + d.error); return; }
            if (d.auth_token) {
                if (win) { try { win.close(); } catch (e) {} }
                plexResources(d.auth_token, cid, ctx);
            } else {
                setTimeout(function () { plexPoll(id, cid, tries + 1, win, ctx); }, 2000);
            }
        }).catch(function () {
            setTimeout(function () { plexPoll(id, cid, tries + 1, win, ctx); }, 2000);
        });
    }

    function plexResources(token, cid, ctx) {
        _plexStatus(ctx, "Signed in. Discovering your Plex servers...");
        // POST so the token stays out of the URL / access logs.
        var body = "action=resources&token=" + encodeURIComponent(token) +
                   "&client_id=" + encodeURIComponent(cid);
        _plexPost(body).then(function (d) {
            if (d.error) { _plexStatus(ctx, "Error: " + d.error); return; }
            plexRenderServers(d.servers || [], token, ctx);
        }).catch(function (e) { _plexStatus(ctx, "Error: " + e); });
    }

    function plexRenderServers(servers, accountToken, ctx) {
        var box = _plexServersEl(ctx);
        box.innerHTML = "";
        if (!servers.length) {
            _plexStatus(ctx, "No Plex servers found for this account.");
            return;
        }
        _plexStatus(ctx, "Found " + servers.length + " server(s). Choose how to use each, then click Apply.");
        var table = document.createElement("table");
        servers.forEach(function (s) {
            var row = table.insertRow();
            var info = row.insertCell();
            info.textContent = (s.name || "Plex Server") + "  -  " + s.scheme + "://" +
                s.host + ":" + s.port + (s.local ? "  (local)" : "") +
                (s.owned ? "" : "  (shared)");
            info.style.paddingRight = "14px";
            var actions = row.insertCell();
            if (ctx !== "extra") {
                actions.appendChild(_plexBtn("Set as primary", function () { plexUse(s, "primary", accountToken, ctx); }));
                actions.appendChild(document.createTextNode(" "));
            }
            actions.appendChild(_plexBtn("Add as extra", function () { plexUse(s, "extra", accountToken, ctx); }));
        });
        box.appendChild(table);
    }

    function _plexBtn(label, fn) {
        var b = document.createElement("input");
        b.type = "button";
        b.value = label;
        b.onclick = fn;
        return b;
    }

    function plexUse(s, mode, accountToken, ctx) {
        var token = s.access_token || accountToken;
        if (mode === "primary") {
            _plexField("mediaserver_type").value = "plex";
            _plexField("mediaserver_url").value = s.scheme;
            _plexField("mediaserver_host").value = s.host;
            _plexField("mediaserver_port").value = s.port;
            _plexField("mediaserver_key").value = token;
            _plexStatus(ctx, "Primary set to " + s.name + ". Review and click Apply to save.");
        } else {
            var extra = _plexField("mediaserver_extra");
            var spec = (s.scheme === "http")
                ? (s.host + "|" + s.port + "|" + token)
                : (s.host + "|" + s.port + "|" + token + "|" + s.scheme);
            var parts = extra.value.trim() ? extra.value.trim().split(/\s+/) : [];
            if (parts.indexOf(spec) === -1) { parts.push(spec); }
            extra.value = parts.join(" ");
            _plexStatus(ctx, "Added " + s.name + " as an extra server. Review and click Apply to save.");
        }
    }
</script>

